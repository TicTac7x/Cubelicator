<Application
    x:Class="Cubelicator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cubelicator">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackground" Color="#222222"/>
            <SolidColorBrush x:Key="DeviceBackground" Color="#111111"/>
            <SolidColorBrush x:Key="DeviceForeground" Color="LightGray"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>