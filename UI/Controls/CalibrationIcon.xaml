<UserControl
    x:Class="Cubelicator.CalibrationIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Image
            x:Name="Element_Calibrated"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Source="ms-appx:///Assets/Calibrated.svg"
            Width="16"
            Height="16"
            Visibility="Collapsed"/>

		<Image
            x:Name="Element_NotCalibrated"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Source="ms-appx:///Assets/NotCalibrated.svg"
            Width="16"
            Height="16"/>
    </Grid>
</UserControl>