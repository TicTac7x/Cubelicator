<UserControl
    x:Class="Cubelicator.UI.Controls.ControllerPortTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cubelicator.UI.Controls"
    Width="300"
    Height="240">

    <Border
        Padding="10"
        Background="{ThemeResource DeviceBackground}"
        CornerRadius="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="20">
                <controls:GamecubeController />
            </Grid>

            <TextBlock
                x:Name="PortText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{ThemeResource DeviceForeground}"
                Text="{Binding Title}" />

        </Grid>

    </Border>

</UserControl>
