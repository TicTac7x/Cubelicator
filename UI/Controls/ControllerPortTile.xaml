<UserControl
    x:Class="Cubelicator.UI.Controls.ControllerPortTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cubelicator.UI.Controls"
    Width="320"
    Height="240">

    <Border
        Padding="10"
        Background="{ThemeResource DeviceBackground}"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image
                x:Name="IconCalibrated"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="ms-appx:///Assets/Calibrated.svg"
                Width="16"
                Height="16"
                Visibility="Collapsed"/>

            <Image
                x:Name="IconNotCalibrated"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="ms-appx:///Assets/NotCalibrated.svg"
                Width="16"
                Height="16"
                ToolTipService.ToolTip="{x:Bind TooltipControllerIsNotCalibrated}"
                Visibility="Collapsed"/>

            <Button
                x:Name="DetailsButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="5"
                Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                PointerEntered="DetailsButton_PointerEntered"
                PointerExited="DetailsButton_PointerExited">

                <controls:IconDetails
                    Width="16"
                    Height="16"/>
            </Button>

            <Grid x:Name="Controller" Grid.Row="0" Padding="20" Visibility="Collapsed">
                <controls:GamecubeController />
            </Grid>

            <Grid x:Name="Port" Grid.Row="0" Width="60" Height="60" Visibility="Visible">
                <controls:ControllerPort />
            </Grid>

            <TextBlock
                x:Name="PortText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{ThemeResource DeviceForeground}">
                Port
            </TextBlock>

            <TextBlock
                x:Name="ControllerText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{ThemeResource DeviceForeground}"
                Visibility="Collapsed">
                Controller
            </TextBlock>

        </Grid>

    </Border>

</UserControl>
