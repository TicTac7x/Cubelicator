<UserControl
    x:Class="Cubelicator.UI.Controls.ControllerPortTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cubelicator.UI.Controls"
    Width="320"
    Height="240">

    <Border
        Padding="10"
        Background="{ThemeResource DeviceBackground}"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="Controller" Grid.Row="0" Padding="20" Visibility="Collapsed">
                <controls:GamecubeController />
            </Grid>

            <Grid x:Name="Port" Grid.Row="0" Width="60" Height="60" Visibility="Visible">
                <controls:ControllerPort />
            </Grid>

            <TextBlock
                x:Name="PortText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{ThemeResource DeviceForeground}">
                Port
            </TextBlock>

            <TextBlock
                x:Name="ControllerText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{ThemeResource DeviceForeground}"
                Visibility="Collapsed">
                Controller
            </TextBlock>

        </Grid>

    </Border>

</UserControl>
