<UserControl
    x:Class="Cubelicator.UI.Controls.ControllerPortTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cubelicator.UI.Controls"
    Width="320"
    Height="240">

    <Border
        Padding="5"
        Background="{x:Bind ColorDeviceBackground}"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Padding="7,0,0,0">
                    <Image
                        x:Name="IconCalibrated"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/Calibrated.svg"
                        Width="16"
                        Height="16"
                        Visibility="Collapsed"/>

                    <Image
                        x:Name="IconNotCalibrated"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/NotCalibrated.svg"
                        Width="16"
                        Height="16"
                        Visibility="Collapsed"/>
                </Grid>

                <Button
                    x:Name="ProfileButton"
                    Grid.Column="1"
                    Visibility="Collapsed">

                    <Button.Flyout>
                        <MenuFlyout x:Name="DynamicProfiles" Placement="Bottom"/>
                    </Button.Flyout>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="5">
                        <TextBlock
                            x:Name="ProfileText"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            Profile
                        </TextBlock>

                        <controls:IconDown />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="DetailsButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="5"
                    Margin="0,0,2,0"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">

                    <Button.Flyout>
                        <MenuFlyout
                            Placement="BottomEdgeAlignedLeft">

                            <MenuFlyoutItem
                                Text="{x:Bind StringCalibrate}"
                                Click="OnMenuItemClickCalibrate"/>

                            <MenuFlyoutSubItem
                                x:Name="DynamicControllerColors"
                                Text="{x:Bind StringChangeColor}">
                            </MenuFlyoutSubItem>

                        </MenuFlyout>
                    </Button.Flyout>

                    <controls:IconDetails
                        Width="16"
                        Height="16"/>
                </Button>
            </Grid>

            <Grid
                x:Name="ControllerRoot"
                Grid.Row="1"
                Padding="20"
                Visibility="Collapsed"/>

            <Grid
                x:Name="Port"
                Grid.Row="1"
                Width="60"
                Height="60"
                Visibility="Visible">
                <controls:ControllerPort
                    x:Name="ControllerPort" />
            </Grid>

            <TextBlock
                x:Name="PortText"
                Grid.Row="2"
                Padding="0,0,0,5"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{x:Bind ColorDeviceForeground}">
                Port
            </TextBlock>

            <TextBlock
                x:Name="ControllerText"
                Grid.Row="2"
                Padding="0,0,0,5"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{x:Bind ColorDeviceForeground}"
                Visibility="Collapsed">
                Controller
            </TextBlock>

        </Grid>

    </Border>

</UserControl>
