<UserControl
    x:Class="Cubelicator.UI.Controls.ControllerPortTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cubelicator.UI.Controls"
    Width="320"
    Height="240">

    <Border
        Padding="10"
        Background="{ThemeResource DeviceBackground}"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image
                x:Name="IconCalibrated"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="ms-appx:///Assets/Calibrated.svg"
                Width="16"
                Height="16"
                Visibility="Collapsed"/>

            <Image
                x:Name="IconNotCalibrated"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="ms-appx:///Assets/NotCalibrated.svg"
                Width="16"
                Height="16"
                Visibility="Collapsed"/>

            <Button
                x:Name="DetailsButton"
                Background="Transparent"
                BorderThickness="0"
                Padding="5"
                Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">

                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">

                        <MenuFlyoutItem
                            Text="Calibrate"
                            Click="OnMenuItemClickCalibrate"/>

                        <MenuFlyoutSubItem Text="Change Color">

                            <MenuFlyoutItem
                                Text="Indigo"
                                Tag="Indigo"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Jet Black"
                                Tag="JetBlack"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Spice Orange"
                                Tag="SpiceOrange"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Platinum"
                                Tag="Platinum"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Emerald Blue"
                                Tag="EmeraldBlue"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="White"
                                Tag="White"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Starlight Gold"
                                Tag="StarlightGold"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Symphonic Green"
                                Tag="SymphonicGreen"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Luigi Green"
                                Tag="LuigiGreen"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Mario Red"
                                Tag="MarioRed"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Wario Yellow"
                                Tag="WarioYellow"
                                Click="OnMenuItemChangeColor"/>

                            <MenuFlyoutItem
                                Text="Gundam Char"
                                Tag="GundamChar"
                                Click="OnMenuItemChangeColor"/>

                        </MenuFlyoutSubItem>

                    </MenuFlyout>
                </Button.Flyout>

                <controls:IconDetails
                    Width="16"
                    Height="16"/>
            </Button>

            <Grid x:Name="Controller" Grid.Row="0" Padding="20" Visibility="Collapsed">
                <controls:GamecubeController x:Name="GamecubeController" />
            </Grid>

            <Grid x:Name="Port" Grid.Row="0" Width="60" Height="60" Visibility="Visible">
                <controls:ControllerPort x:Name="ControllerPort" />
            </Grid>

            <TextBlock
                x:Name="PortText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{ThemeResource DeviceForeground}">
                Port
            </TextBlock>

            <TextBlock
                x:Name="ControllerText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{ThemeResource DeviceForeground}"
                Visibility="Collapsed">
                Controller
            </TextBlock>

        </Grid>

    </Border>

</UserControl>
