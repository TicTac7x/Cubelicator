<UserControl
    x:Class="Cubelicator.IconDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Cubelicator="using:Cubelicator">
    <Viewbox Width="16" Height="16">
        <Canvas Width="16" Height="16">

            <Rectangle
                Width="4"
                Height="3"
                RadiusX="3"
                RadiusY="3"
                Fill="{x:Bind Cubelicator:Colors.DeviceForeground}"
                Canvas.Left="6"
                Canvas.Top="1" />

            <Rectangle
                Width="4"
                Height="3"
                RadiusX="3"
                RadiusY="3"
                Fill="{x:Bind Cubelicator:Colors.DeviceForeground}"
                Canvas.Left="6"
                Canvas.Top="6" />

            <Rectangle
                Width="4"
                Height="3"
                RadiusX="3"
                RadiusY="3"
                Fill="{x:Bind Cubelicator:Colors.DeviceForeground}"
                Canvas.Left="6"
                Canvas.Top="12" />

        </Canvas>
    </Viewbox>
</UserControl>