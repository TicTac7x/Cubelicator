<UserControl
    x:Class="Cubelicator.IconDown"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Cubelicator="using:Cubelicator">
    <Viewbox Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path
            Stroke="{x:Bind Cubelicator:Colors.DeviceForeground}"
            StrokeThickness="2"
            Data="M 2.5,4.5 L 8,10.5 L 13.5,4.5" />
        </Canvas>
    </Viewbox>
</UserControl>