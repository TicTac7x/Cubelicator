<UserControl
    x:Class="Cubelicator.UI.Controls.IconDown"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Width="16" Height="16">
        <Canvas Width="16" Height="16">
            <Path
            Stroke="{x:Bind ColorDeviceForeground}"
            StrokeThickness="2"
            Data="M 2.5,4.5 L 8,10.5 L 13.5,4.5" />
        </Canvas>
    </Viewbox>
</UserControl>