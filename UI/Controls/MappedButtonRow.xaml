<UserControl
    x:Class="Cubelicator.UI.Controls.MappedButtonRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="using:Cubelicator.UI.Controller">

    <Grid
        Padding="20,10"
        Background="{x:Bind ColorRowBackground}"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            Spacing="10">
            <Grid
                x:Name="GamecubeButton"
                Width="40"
                Height="40" />
            <TextBlock
                x:Name="GamecubeButtonName"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </StackPanel>

        <Image
            Grid.Column="1"
            Width="24"
            Height="24"
            Margin="20,0">
            <Image.Source>
                <SvgImageSource UriSource="ms-appx:///Assets/IconMapped.svg" />
            </Image.Source>
        </Image>

        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
            <TextBlock
                x:Name="XboxButtonName"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <Image
                x:Name="XboxButton"
                Grid.Column="1"
                Width="32"
                Height="32" />
        </StackPanel>
    </Grid>
</UserControl>
