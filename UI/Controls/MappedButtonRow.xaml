<UserControl
    x:Class="Cubelicator.UI.Controls.MappedButtonRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="using:Cubelicator.UI.Controller">

    <Grid
        x:Name="Root"
        Background="{x:Bind ColorRowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="10,10,20,10"
            Background="Transparent"
            PointerEntered="OnPointerEntered"
            PointerExited="OnPointerExited"
            PointerReleased="OnPointerReleased">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            Spacing="10">
                <Grid
                x:Name="GamecubeButton"
                Width="40"
                Height="40" />
                <TextBlock
                x:Name="GamecubeButtonName"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            </StackPanel>

            <Image
            Grid.Column="1"
            Width="24"
            Height="24"
            Margin="20,0">
                <Image.Source>
                    <SvgImageSource UriSource="ms-appx:///Assets/IconMapped.svg" />
                </Image.Source>
            </Image>

            <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="10">
                <TextBlock
                x:Name="XboxButtonName"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

                <Image
                x:Name="XboxButton"
                Grid.Column="1"
                Width="40"
                Height="40" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ExpandablePanel" Grid.Row="1" Visibility="Collapsed" Padding="10,10,20,10" Background="{x:Bind ColorExpandableBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left">
                    Mapped Button:
                </TextBlock>

                <Button x:Name="MappedButton" HorizontalAlignment="Right" VerticalAlignment="Center" Width="100">
                    <Button.Flyout>
                        <MenuFlyout x:Name="RootMappableButtons" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
            </Grid>

            <Grid
                x:Name="SensitivityPanel"
                Grid.Row="1"
                ColumnSpacing="10"
                Margin="0,10,0,0"
                Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Sensitivity" />

                <Slider x:Name="SensitivitySlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="2"
                    SmallChange="0.1"
                    StepFrequency="0.1"
                    ValueChanged="OnSensitivityChanged" />

                <TextBlock x:Name="SensitivityValue"
                   Grid.Column="2"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Text="1.00" />
            </Grid>

            <Grid
                x:Name="DeadzonePanel"
                Grid.Row="2"
                ColumnSpacing="10"
                Margin="0,10,0,0"
                Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Deadzone" />

                <Slider x:Name="DeadzoneSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="2"
                    SmallChange="0.1"
                    StepFrequency="0.1"
                    ValueChanged="OnDeadzoneChanged"/>

                <TextBlock x:Name="DeadzoneValue"
                   Grid.Column="2"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Text="1.00" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
