<UserControl
    x:Class="Cubelicator.UI.Controls.Navigator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="30,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </UserControl.Resources>

    <StackPanel Orientation="Horizontal"
                Background="{x:Bind ColorDeviceBackground}">

        <Border x:Name="Dashboard"
                Style="{StaticResource NavItemStyle}"
                Tag="{x:Bind NavButtonDashboard}"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerPressed="OnPointerPressed"
                PointerReleased="OnNavClick">

            <TextBlock Text="DASHBOARD"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border x:Name="Controller1"
                Style="{StaticResource NavItemStyle}"
                Tag="{x:Bind NavButtonController1}"
                Visibility="Collapsed"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerPressed="OnPointerPressed"
                PointerReleased="OnNavClick">

            <TextBlock Text="CONTROLLER 1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border x:Name="Controller2"
                Style="{StaticResource NavItemStyle}"
                Tag="{x:Bind NavButtonController2}"
                Visibility="Collapsed"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerPressed="OnPointerPressed"
                PointerReleased="OnNavClick">

            <TextBlock Text="CONTROLLER 2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border x:Name="Controller3"
                Style="{StaticResource NavItemStyle}"
                Tag="{x:Bind NavButtonController3}"
                Visibility="Collapsed"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerPressed="OnPointerPressed"
                PointerReleased="OnNavClick">

            <TextBlock Text="CONTROLLER 3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border x:Name="Controller4"
                Style="{StaticResource NavItemStyle}"
                Tag="{x:Bind NavButtonController4}"
                Visibility="Collapsed"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerPressed="OnPointerPressed"
                PointerReleased="OnNavClick">

            <TextBlock Text="CONTROLLER 4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

    </StackPanel>
</UserControl>