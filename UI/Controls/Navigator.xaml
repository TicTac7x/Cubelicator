<UserControl
    x:Class="Cubelicator.Navigator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Cubelicator="using:Cubelicator">

    <UserControl.Resources>

        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="30,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </UserControl.Resources>

    <StackPanel Orientation="Horizontal"
                Background="{x:Bind Cubelicator:Colors.DeviceBackground}">

        <Border
            x:Name="Element_Dashboard"
            Style="{StaticResource NavItemStyle}"
            Tag="{x:Bind Cubelicator:AppView.Dashboard}"
            PointerEntered="UIEvent_OnPointerEntered"
            PointerExited="UIEvent_OnPointerExited"
            PointerPressed="UIEvent_OnPointerPressed"
            PointerReleased="UIEvent_NavigationItem"
            Background="{x:Bind Cubelicator:Colors.AppBackground}">

            <TextBlock 
                Text="{x:Bind Cubelicator:Strings.Navigator_Dashboard}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
        </Border>

        <Border
            x:Name="Element_Controller1"
            Style="{StaticResource NavItemStyle}"
            Tag="{x:Bind Cubelicator:AppView.Controller1}"
            Visibility="Collapsed"
            PointerEntered="UIEvent_OnPointerEntered"
            PointerExited="UIEvent_OnPointerExited"
            PointerPressed="UIEvent_OnPointerPressed"
            PointerReleased="UIEvent_NavigationItem">

            <TextBlock
                Text="{x:Bind Cubelicator:Strings.Navigator_Controller1}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
        </Border>

        <Border
            x:Name="Element_Controller2"
            Style="{StaticResource NavItemStyle}"
            Tag="{x:Bind Cubelicator:AppView.Controller2}"
            Visibility="Collapsed"
            PointerEntered="UIEvent_OnPointerEntered"
            PointerExited="UIEvent_OnPointerExited"
            PointerPressed="UIEvent_OnPointerPressed"
            PointerReleased="UIEvent_NavigationItem">

            <TextBlock
                Text="{x:Bind Cubelicator:Strings.Navigator_Controller2}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
        </Border>

        <Border
            x:Name="Element_Controller3"
            Style="{StaticResource NavItemStyle}"
            Tag="{x:Bind Cubelicator:AppView.Controller3}"
            Visibility="Collapsed"
            PointerEntered="UIEvent_OnPointerEntered"
            PointerExited="UIEvent_OnPointerExited"
            PointerPressed="UIEvent_OnPointerPressed"
            PointerReleased="UIEvent_NavigationItem">

            <TextBlock
                Text="{x:Bind Cubelicator:Strings.Navigator_Controller3}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
        </Border>

        <Border
            x:Name="Element_Controller4"
            Style="{StaticResource NavItemStyle}"
            Tag="{x:Bind Cubelicator:AppView.Controller4}"
            Visibility="Collapsed"
            PointerEntered="UIEvent_OnPointerEntered"
            PointerExited="UIEvent_OnPointerExited"
            PointerPressed="UIEvent_OnPointerPressed"
            PointerReleased="UIEvent_NavigationItem">

            <TextBlock
                Text="{x:Bind Cubelicator:Strings.Navigator_Controller4}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
        </Border>

        <Border
            x:Name="Element_Calibration"
            Style="{StaticResource NavItemStyle}"
            Tag="{x:Bind Cubelicator:AppView.Calibration}"
            Visibility="Collapsed"
            PointerEntered="UIEvent_OnPointerEntered"
            PointerExited="UIEvent_OnPointerExited"
            PointerPressed="UIEvent_OnPointerPressed"
            PointerReleased="UIEvent_NavigationItem">

            <TextBlock
                Text="{x:Bind Cubelicator:Strings.Navigator_Calibration}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
        </Border>

    </StackPanel>
</UserControl>