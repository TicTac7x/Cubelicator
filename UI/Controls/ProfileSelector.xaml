<UserControl
    x:Class="Cubelicator.UI.Controls.ProfileSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cubelicator.UI.Controls">

	<StackPanel Orientation="Horizontal" Spacing="10">
		<TextBlock x:Name="ProfileText" Visibility="Collapsed" VerticalAlignment="Center">Profile:</TextBlock>
		
		<Button VerticalAlignment="Center">
			<Button.Flyout>
				<MenuFlyout x:Name="RootProfiles" Placement="Bottom"/>
			</Button.Flyout>

			<StackPanel
				Orientation="Horizontal"
				Spacing="5">
				<TextBlock
					x:Name="SelectedProfile"
					HorizontalAlignment="Center"
					VerticalAlignment="Center" />

				<controls:IconDown />
			</StackPanel>
		</Button>

		<Button x:Name="ProfileManagerButton" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
			<Button.Flyout>
				<MenuFlyout Placement="BottomEdgeAlignedLeft">
					<MenuFlyoutItem
                        Text="New"
                        Click="OnNewProfile"/>
				</MenuFlyout>
			</Button.Flyout>
			
			<controls:IconDetails/>
		</Button>
	</StackPanel>
</UserControl>