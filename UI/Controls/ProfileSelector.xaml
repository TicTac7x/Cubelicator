<UserControl
    x:Class="Cubelicator.ProfileSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Cubelicator="using:Cubelicator">

	<StackPanel Orientation="Horizontal" Spacing="10">
		<TextBlock x:Name="ProfileText" Visibility="Collapsed" VerticalAlignment="Center">Profile:</TextBlock>
		
		<Button x:Name="Element_SelectedProfile" VerticalAlignment="Center" MinWidth="100">
			<Button.Flyout>
				<MenuFlyout x:Name="RootProfiles" Placement="Bottom"/>
			</Button.Flyout>

            <StackPanel
				Orientation="Horizontal"
				Spacing="5">
                <Grid>
                    <TextBlock
						x:Name="SelectedProfileText"
						HorizontalAlignment="Center"
						VerticalAlignment="Center" />
                </Grid>

                <Cubelicator:IconDown />
            </StackPanel>
        </Button>

        <TextBox
			x:Name="SelectedProfileEdit"
            MinWidth="100"
			Visibility="Collapsed"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			KeyDown="OnRenameKeyDown"
			LostFocus="OnRenameLostFocus"/>

        <Button x:Name="ProfileManagerButton" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
			<Button.Flyout>
				<MenuFlyout Placement="BottomEdgeAlignedLeft">
					<MenuFlyoutItem
                        Text="{x:Bind Cubelicator:Strings.ProfileSelector_New}"
                        Click="OnNewProfile"/>

					<MenuFlyoutItem
						Text="{x:Bind Cubelicator:Strings.ProfileSelector_Rename}"
						Click="OnRenameProfile"/>

                    <MenuFlyoutItem
                        x:Name="Element_DeleteProfile"
						Text="{x:Bind Cubelicator:Strings.ProfileSelector_Delete}"
						Click="OnDeleteProfile"/>
                </MenuFlyout>
			</Button.Flyout>

            <Cubelicator:IconDetails />
        </Button>
	</StackPanel>
</UserControl>