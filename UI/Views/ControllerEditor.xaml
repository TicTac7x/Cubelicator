<UserControl
    x:Class="Cubelicator.UI.Views.ControllerEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cubelicator.UI.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" Padding="0, 150">
            <Grid x:Name="ControllerRoot" />
        </Grid>

        <Grid Grid.Column="2" Background="{x:Bind ColorButtonPressed}"
              BorderThickness="1,0,0,0" BorderBrush="{x:Bind ColorDeviceBackground}">
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel
                    x:Name="RootMappedButtons"
                    Orientation="Vertical" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
