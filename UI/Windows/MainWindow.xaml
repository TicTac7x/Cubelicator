<Window
    x:Class="Cubelicator.UI.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cubelicator.UI.Controls">

    <Grid x:Name="Root" Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <TitleBar x:Name="TitleBar" Background="{ThemeResource DeviceBackground}">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xF4AA;" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid
            Grid.Row="1"
            Margin="20"
            ColumnSpacing="30"
            HorizontalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:ControllerPortTile x:Name="ControllerPortTile1" Grid.Column="0"/>
            <controls:ControllerPortTile x:Name="ControllerPortTile2" Grid.Column="1"/>
            <controls:ControllerPortTile x:Name="ControllerPortTile3" Grid.Column="2"/>
            <controls:ControllerPortTile x:Name="ControllerPortTile4" Grid.Column="3"/>
        </Grid>
    </Grid>

</Window>
