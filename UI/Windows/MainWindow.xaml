<Window
    x:Class="Cubelicator.UI.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Cubelicator.UI.Views">

    <Grid x:Name="Root" Background="{x:Bind ColorAppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="TitleBar" Background="{x:Bind ColorDeviceBackground}">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xF4AA;" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid x:Name="DashboardRoot" />
            <Grid x:Name="ControllerEditorRoot" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
