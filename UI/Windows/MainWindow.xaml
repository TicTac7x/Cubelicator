<Window
    x:Class="Cubelicator.UI.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cubelicator.UI.Controls">

    <Grid x:Name="Root" Background="{x:Bind ColorAppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="TitleBar" Background="{x:Bind ColorDeviceBackground}">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xF4AA;" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel
            x:Name="ControllerPortTiles"
            Grid.Row="1"
            Margin="20"
            Spacing="30"
            Orientation="Horizontal"
            HorizontalAlignment="Center">
        </StackPanel>
    </Grid>

</Window>
